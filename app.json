{
  "expo": {
    "name": "One Button",
    "slug": "router-connect-app",
    "version": "1.0.0",
    "platforms": [
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/wifi-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.routerconnectapp",
      "adaptiveIcon": {
        "backgroundColor": "#086CFA",
        "foregroundImage": "./assets/wifi-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/wifi-app-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/with-router-cleartext"
    ]
  }
}
